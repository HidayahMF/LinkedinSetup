NODE_ENV=development
PORT=3000

# MongoDB (Atlas example)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=linkedin_ai_agent

# AI provider abstraction: local | openai_compatible
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Authentication session lifetime in hours (opaque bearer tokens, hashed at rest)
AUTH_SESSION_TTL_HOURS=24

# CORS allowlist for browser clients (comma-separated). The Vite dev server
# proxies /api same-origin, so this only matters for direct cross-origin access.
CORS_ORIGINS=http://localhost:5173

# Browser automation executor selection: simulation | playwright | module
# - simulation (default): honest no-op executor, every result = UNVERIFIED
# - playwright: real Chromium executor; REQUIRES LINKEDIN_BROWSER_PROFILE_PATH
#   (fails closed when missing). No silent fallback to simulation on failure.
# - module: load an external module exposing createAutomationProvider()
AUTOMATION_PROVIDER=simulation
AUTOMATION_MODULE=

# Persistent browser profile directory — session/cookies live ONLY inside the
# executor process. Never point this at anything you share between tools.
# LINKEDIN_BROWSER_PROFILE_PATH=./.linkedin-profile
# Run the browser visibly so you can take over during security challenges.
LINKEDIN_HEADLESS=false

# Optional: comma-separated DNS resolvers if your local resolver refuses SRV queries
# DNS_SERVERS=1.1.1.1,8.8.8.8
