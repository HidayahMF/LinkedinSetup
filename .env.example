NODE_ENV=development
PORT=3000

# MongoDB (Atlas example)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=linkedin_ai_agent

# AI provider abstraction: local | openai_compatible
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional browser automation module implementing createAutomationProvider()
# Leave empty to use the honest simulation executor (results = UNVERIFIED).
AUTOMATION_MODULE=

# Optional: comma-separated DNS resolvers if your local resolver refuses SRV queries
# DNS_SERVERS=1.1.1.1,8.8.8.8
